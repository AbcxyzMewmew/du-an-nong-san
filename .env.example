# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG GREENFARM (MẪU - .env.example)
# ==========================================================

# Cổng máy chủ backend
PORT=3000
NODE_ENV=development

# Khóa bí mật ký JWT (Cần thay đổi khóa phức tạp trong môi trường production thực tế)
JWT_SECRET=greenfarm_dev_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Khóa bí mật xác thực chữ ký Webhook cổng thanh toán Sandbox
SANDBOX_WEBHOOK_SECRET=greenfarm_sandbox_webhook_secret_key_2026

# Cấu hình máy chủ gửi Email thông báo (Bỏ trống sẽ chạy chế độ giả lập Development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GreenFarm" <no-reply@greenfarm.vn>

# Cấu hình dịch vụ gửi SMS (Bỏ trống sẽ chạy chế độ giả lập Development)
SMS_PROVIDER=esms
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME=GreenFarm
